# Copie para backend/.env no PythonAnywhere e substitua todos os exemplos.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=SUBSTITUA-POR-UMA-CHAVE-ALEATORIA
DJANGO_ALLOWED_HOSTS=SEU-USUARIO.pythonanywhere.com
DJANGO_CORS_ALLOWED_ORIGINS=https://SEU-PROJETO.vercel.app
DJANGO_CSRF_TRUSTED_ORIGINS=https://SEU-PROJETO.vercel.app
PUBLIC_APP_URL=https://SEU-PROJETO.vercel.app
# Com /api encaminhado pelo Vercel, mantenha Lax.
DJANGO_COOKIE_SAMESITE=Lax
DJANGO_SERVE_FRONTEND=false
# PythonAnywhere termina HTTPS no proxy da plataforma.
TRUST_PROXY_SSL_HEADER=true
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@example.invalid
