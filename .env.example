# Production: generate a unique key; do not commit .env.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.example
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example
PUBLIC_APP_URL=https://your-domain.example
# Enable only behind a trusted reverse proxy that overwrites this header.
TRUST_PROXY_SSL_HEADER=false
# Optional SMTP enables password-reset email.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@your-domain.example
