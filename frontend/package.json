{
  "name": "meu-combustivel",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4173 --strictPort",
    "build": "vue-tsc -b && vite build",
    "test": "node --test src/utils/*.test.mjs",
    "dev:server": "vite --mode django --host 0.0.0.0 --port 4173",
    "build:server": "vue-tsc -b && vite build --mode django",
    "dev:demo": "vite --mode demo --host 0.0.0.0 --port 4174 --strictPort",
    "build:demo": "vue-tsc -b && vite build --mode demo",
    "configure:vercel": "node scripts/configure-vercel.mjs",
    "format": "prettier --write src"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "lucide-vue-next": "^0.468.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/google.maps": "^3.66.4",
    "@types/leaflet": "^1.9.15",
    "@vitejs/plugin-vue": "^5.2.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.0",
    "vue-tsc": "^2.2.0"
  }
